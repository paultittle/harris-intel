class LiveChatManager {

    _page = "";
    _logger = null;
    _env = "development";
    _apiUrl = "";
    _chatId = 0;

    constructor() {
        this._apiUrl = 'https://maestro.hcad.org/livechat/LiveChat';
        this._page = GetPage();
    }

    CheckStatus() {
        var base = this;
        this._page = GetPage();
		//alert(this._page )
		if( 1 != 1 )
		{
			//LiveChatWidget.call("hide");
			return null;
		}
		else {	
			var mUrl = this._apiUrl + '/CheckStatus?page=' + this._page;
			$.ajax({
				url: mUrl,
				type: 'POST',
				crossDomain: true,
				success: function (data) {
					var sjson = data.substring(1, data.length - 1);
					var json= $.parseJSON(sjson);

					if( json.ChatId != null && json.bitEnabled === true ) {
						//window.__lc.license = '15365838/' + json.ChatId;
						if( json.Page.replace( /=/g, '*' ) == GetPage() && json.bitEnabled == true) {
							window.__lc = window.__lc || {};
							window.__lc.license = 15365838;
							; (function (n, t, c) {
								function i(n) { return e._h ? e._h.apply(null, n) : e._q.push(n) };
								var e = {
									_q: [], _h: null, _v: "2.0", on: function () { i(["on", c.call(arguments)]) }, once: function () {
										i(["once", c.call(arguments)])
									}, off: function () { i(["off", c.call(arguments)]) },
									get: function () {
										if (!e._h) throw new Error("[LiveChatWidget] You can't use getters before load.");
										return i(["get", c.call(arguments)])
									}, call: function () { i(["call", c.call(arguments)]) }, init: function () {
										var n = t.createElement("script");
										n.async = !0, n.type = "text/javascript",
											n.src = "https://cdn.livechatinc.com/tracking.js", t.head.appendChild(n)
									}
								};
								!n.__lc.asyncInit && e.init(), n.LiveChatWidget = n.LiveChatWidget || e
							}(window, document, [].slice))
						}
					}
					//else {
					//	if( LiveChatWidget != undefined )
					//		LiveChatWidget.call("hide");
					//}
				}
			});
		}
    }
}

function GetPage() {
    var page = document.location.href;
    var del = "";
    for( var i=0; i<3;i++){
        if( del.length > 0) del += "/"
        del += page.split( '/' )[i]
    }
    page = page.replace(del + '/','');
    page = btoa( page ).replace( /=/g, '*' );
    if( page == '' || page == null ) page = 'default';
    return page;
}

var chat = new LiveChatManager();
chat.CheckStatus();

